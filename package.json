    "next": "16.3.5",
    "pixi.js": "^8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.104.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "typescript": "^5"
  }
}
